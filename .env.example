# Runtime configuration. Copy to `.env` and adjust:  cp .env.example .env
# docker-compose.yml reads this file and passes the variables below into the app container.
# Without Docker, export them in the shell before `npm start` (see README.md / DEPLOY.md).
# Build- and test-only variables (BUILD_ID, NEXT_DIST_DIR, PORT for E2E, ...) are listed in CONTRIBUTING.md.

# ── Required for Docker ───────────────────────────────────────────────────────
# Domain the app is served on. Caddy obtains an HTTPS certificate for it automatically.
DOMAIN=kampagne.example.com

# ── Core ──────────────────────────────────────────────────────────────────────
# Public base URL for links in e-mails, push and Discord messages (player page, reader view, unsubscribe links).
# Docker: always https://$DOMAIN (set in docker-compose.yml). Without APP_URL the address an admin saved under
# Account -> Services is used, otherwise http://localhost:3000.
# APP_URL=https://kampagne.example.com

# 1 only for local tests over plain HTTP: session cookie without the Secure flag, no upgrade-insecure-requests.
# Never set this on an instance that is reachable from the internet.
INSECURE_COOKIES=0

# Optional fixed one-time token for the first-run setup (at least 16 characters, e.g. `openssl rand -hex 24`).
# Without it the app generates a random token on every start while no account exists and writes it to the log
# (`docker compose logs app | grep Ersteinrichtung`). Remove it again after the admin account has been created.
# SETUP_TOKEN=

# 1 = read the client IP for the login rate limit from X-Forwarded-For / X-Real-IP. Only set this when the app is
# reachable exclusively through your own reverse proxy, and that proxy overwrites/appends these headers (Caddy in
# docker-compose.yml does). Otherwise any client could forge the headers. Default 0; docker-compose.yml sets 1.
# TRUST_PROXY=0

# Time zone; also decides when the daily backups run (from 03:00 server time). Default in Docker: Europe/Berlin.
# TZ=Europe/Berlin

# ── Look (build time) ─────────────────────────────────────────────────────────
# Motifs drawn in code (wax seal, engraved mottos on the map frames): imperial (default; skull seal, imperial
# mottos, matching the images under public/) or neutral (compass seal, neutral mottos).
# Build-time only: it is inlined by `next build`, so set it before building (docker compose passes it as a build
# arg); changing it on a running container has no effect. It does not change the images under public/.
# NEXT_PUBLIC_FLAVOR=imperial
# Default language of the build: de | en | fr | es | pl (default en). Last fallback of the language choice (after ?lang,
# the language switch, the account/player/campaign language, the default language saved at first setup and the
# browser's Accept-Language); it also preselects the first-setup form when the browser language is not supported.
# Build-time only like NEXT_PUBLIC_FLAVOR. An existing installation keeps the default language chosen at first setup.
# NEXT_PUBLIC_DEFAULT_LOCALE=en

# ── Storage ───────────────────────────────────────────────────────────────────
# Defaults without Docker: ./data, ./uploads and $DATA_DIR/backups. The Docker image sets the /app/... paths.
# DATA_DIR=/app/data
# UPLOAD_DIR=/app/uploads
# BACKUP_DIR=/app/backups
# Image storage per campaign in MB; further uploads of that campaign are rejected when it is full. Default 200.
# UPLOAD_QUOTA_MB=200

# ── E-mail (optional; the SMTP settings under Account -> E-mail take precedence) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# 1 = direct TLS (port 465). Otherwise STARTTLS is mandatory.
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# Sender address; also used as the contact for web push (VAPID subject).
# SMTP_FROM=Campaign <kampagne@example.com>
# 1 = allow SMTP without enforced TLS (only for a local relay on the same host). Default 0.
# SMTP_ALLOW_INSECURE=0

# ── Operations ────────────────────────────────────────────────────────────────
# 1 = switch off the background jobs (message outbox, deadline reminders, automatic backups, clean-up). Default 0.
# DISABLE_SCHEDULER=0
# Commit shown on the health page (optional; GIT_COMMIT takes precedence over SOURCE_COMMIT).
# GIT_COMMIT=
# SOURCE_COMMIT=
